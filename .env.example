# Copy to .env and fill in. .env is gitignored — never commit real keys.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override the OCR model (default: google/gemini-2.5-flash-lite).
# Any OpenRouter model that accepts image input works, e.g. openai/gpt-5.5
# If you change it, also update PRICE_*_PER_M in src/config.py (fallback cost estimate only).
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Optional: OCR reasoning effort (default: none = disabled). low/medium/high enable it;
# "none" was cheaper and more accurate for gemini-2.5-flash-lite OCR in testing.
# OPENROUTER_REASONING_EFFORT=low
